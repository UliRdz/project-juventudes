# .env.example
# PURPOSE: A committed TEMPLATE listing every environment variable the app needs.
# Each developer copies this to a real `.env` (which is git-ignored) and fills in
# values. This keeps secrets out of the repo while documenting what is required.
# INTENDED OUTPUT LINK: the backend reads these at startup (db connection, CORS,
# JWT, SMTP); wrong/missing values are the usual cause of "it runs locally but
# breaks in production".

# ---- backend ----
PORT=4000                                                      # Port the Express server listens on locally (hosts override this).
DATABASE_URL=postgres://postgres:Ux70eVi1@localhost:5432/juventudes_dev  # Full PostgreSQL connection string used by src/config/db.js.
DATABASE_SSL=false                                             # false locally; set true on Render/Railway (managed Postgres needs SSL).
FRONTEND_ORIGIN=http://localhost:5173                          # Origin allowed by CORS; set to your GitHub Pages URL in production.
JWT_SECRET=change_me_to_a_long_random_string                   # Secret used to sign USER login tokens (Day 2); must be long, random, and private.
ADMIN_JWT_SECRET=change_me_to_a_DIFFERENT_long_random_string   # Day 5: separate secret for ADMIN tokens. Falls back to JWT_SECRET if unset,
                                                               # but setting a different value means one leaked secret can't compromise both systems.
# SMTP (used Day 4 for the chat email relay)
SMTP_HOST=                                                     # Mail server host (e.g. Mailtrap in dev, a real relay in prod).
SMTP_PORT=587                                                  # Mail server port (587 = STARTTLS, the common default).
SMTP_USER=                                                     # SMTP username/login.
SMTP_PASS=                                                     # SMTP password (secret — never commit the real value).
SMTP_FROM=juventudes@gtoxmundo.com                             # "From" address shown on chat notification emails.
# Scholarship source (used Day 4 by the 24h importer)
SCHOLARSHIP_API_URL=                                           # URL the cron fetches nightly to refresh scholarships; blank = importer skips.

# ---- frontend (Vite) ----
VITE_API_URL=http://localhost:4000                             # Backend base URL the frontend calls; must be VITE_-prefixed to reach the browser.
